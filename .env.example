# Copy this file to ".env" and fill in your own values. Never commit ".env".

# ===== Backend =====
ENROLL_URL=http://ENROLL_API_HOST:PORT/api/v1/employees/enroll
API_KEY=your-enrollment-api-key
APP_TOKEN=choose-a-long-random-token

# ===== Sign in =====
# token = everyone uses the shared APP_TOKEN (no login screen)
# login = every operator signs in with a personal account (create accounts with manage_users.py)
AUTH_MODE=token
# Secret used to sign the login tokens (32+ random characters). Needed when AUTH_MODE=login
JWT_SECRET=
TOKEN_HOURS=12
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=10

# ===== Network: the PC that runs the backend (the app connects here) =====
SERVER_HOST=192.168.1.10
SERVER_PORT=8005
# true when the server is reached through https / wss
SERVER_SECURE=false

# ===== Web app (browser) =====
# Pages allowed to call the backend, comma separated
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Set to true if left and right are reversed on the web front camera
SWAP_WEB_FRONT=false

# ===== App identity and version =====
APP_NAME=SM FaceID
APP_SLUG=sm-faceid
APP_VERSION=1.0.0
ANDROID_PACKAGE=com.example.faceid
IOS_BUNDLE_ID=com.example.faceid
GITHUB_REPO=your-username/your-repo
APP_DEBUG=false

# ===== Employee lookup by card number (Oracle) =====
# Leave EMP_DB_USER empty to turn it off (the app then asks for the details manually).
# The SQL must return exactly these 5 columns in this order:
#   employee_id, employee_name, deptt_name, section_name, designation_name
# and must filter with the bind variable :card
EMP_DB_USER=
EMP_DB_PASSWORD=
EMP_DB_DSN=HOST:1521/SERVICE_NAME
EMP_LOOKUP_SQL="SELECT employee_id, employee_name, deptt_name, section_name, designation_name FROM your_employee_table WHERE your_card_column = :card"

# ===== Enrollment difficulty =====
# fast     = quickest and easiest (captures on the first good frame)
# balanced = recommended: each angle is confirmed by a second frame, photo quality is checked
# strict   = best photo quality, slowest
ENROLL_MODE=balanced

# Camera direction (set to true if left and right are reversed for that camera)
SWAP_FRONT=false
SWAP_BACK=false

# ===== Saved photos =====
# CROP_FACES=true saves and sends only the face area instead of the full camera frame
CROP_FACES=true
CROP_MARGIN=0.45
CROP_MAX_SIZE=640
# false = do not keep local copies of the photos on the server (the enrollment API stores them)
SAVE_LOCAL_COPIES=true

# ===== Optional overrides (values shown are the "balanced" defaults, angles in degrees) =====
# Remove the leading # to override one value of the selected mode.
# MIN_SHARPNESS=10
# REQUIRE_STABLE=true
# STABLE_TOL=6
# START_DELAY=0.8
# MIN_FACE_SIZE=0.12
# MIN_EYE_OPEN=0.12
# MAX_ROLL=20
# MIN_FACE_CONF=0.50
# MIN_BRIGHT=40
# MAX_BRIGHT=230
# FRONT_YAW_MIN=-15
# FRONT_YAW_MAX=15
# FRONT_PITCH_MIN=-25
# FRONT_PITCH_MAX=25
# YAW_DELTA=15
# YAW_MAX=40
# PITCH_DELTA=10
# PITCH_MAX=25
# CROSS_TOL=15