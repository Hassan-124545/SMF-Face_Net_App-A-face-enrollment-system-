# Copy this file to ".env" and fill in your own values. Never commit ".env".

# ===== Backend =====
ENROLL_URL=http://ENROLL_API_HOST:PORT/api/v1/employees/enroll
API_KEY=your-enrollment-api-key
APP_TOKEN=choose-a-long-random-token

# ===== Network: the PC that runs the backend (the app connects here) =====
SERVER_HOST=192.168.1.10
SERVER_PORT=8005

# ===== App identity and version =====
APP_NAME=SM FaceID
APP_SLUG=sm-faceid
APP_VERSION=1.0.0
ANDROID_PACKAGE=com.example.faceid
IOS_BUNDLE_ID=com.example.faceid
GITHUB_REPO=your-username/your-repo
APP_DEBUG=false

# ===== Enrollment difficulty =====
# fast     = quickest and easiest (captures on the first good frame)
# balanced = recommended: each angle is confirmed by a second frame, photo quality is checked
# strict   = best photo quality, slowest
ENROLL_MODE=balanced

# Camera direction (set to true if left and right are reversed for that camera)
SWAP_FRONT=false
SWAP_BACK=false

# ===== Saved photos =====
# CROP_FACES=true saves and sends only the face area instead of the full camera frame
CROP_FACES=true
CROP_MARGIN=0.45
CROP_MAX_SIZE=640
# A cropped photo must contain exactly one face with at least this detector score
PHOTO_MIN_CONF=0.40
# After this many failed checks the photo is sent anyway and the server decides
VERIFY_TRIES=3
# How many times one angle is retaken when the enrollment API rejects its photo
MAX_RETRIES=3

# ===== Optional overrides (values shown are the "balanced" defaults) =====
# Remove the leading # to override one value of the selected mode.
# Angles are in degrees, measured from the front photo.
# REQUIRE_STABLE=true
# STABLE_TOL=6
# START_DELAY=0.8
# MIN_SHARPNESS=10
# SHARP_RATIO=0.50
# MIN_FACE_SIZE=0.12
# MIN_EYE_OPEN=0.12
# MAX_ROLL=20
# MIN_FACE_CONF=0.50
# MIN_BRIGHT=40
# MAX_BRIGHT=230
# FRONT_YAW_MIN=-15
# FRONT_YAW_MAX=15
# FRONT_PITCH_MIN=-25
# FRONT_PITCH_MAX=25
# YAW_DELTA=15
# YAW_MAX=40
# PITCH_DELTA=10
# PITCH_MAX=25
# CROSS_TOL=15